    "@nx/jest": "~24.0.0",
    "@nx/js": "~24.0.0",
    "@o3r/build-helpers": "workspace:^",
    "@o3r/eslint-config": "workspace:^",
    "@o3r/eslint-plugin": "workspace:^",
    "@o3r/test-helpers": "workspace:^",
    "@schematics/angular": "~22.2.0",
    "@stylistic/eslint-plugin": "~5.6.0",
    "@types/jest": "~30.0.0",
    "@types/node": "~26.6.0",
