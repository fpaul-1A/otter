    "@angular/core": "~22.2.0",
    "@angular/platform-browser": "~22.2.0",
    "@angular/platform-browser-dynamic": "~22.2.0",
    "@eslint-community/eslint-plugin-eslint-comments": "^4.4.0",
    "@modelcontextprotocol/sdk": "~1.25.0",
    "@nx/eslint": "~24.0.0",
